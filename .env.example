# -----------------------------------------------------------------------------
# FrostMail Environment Configuration
# -----------------------------------------------------------------------------

# 1. Database (Neon / PostgreSQL) - REQUIRED
# Connection string for user sessions, saved templates, and subscriptions
DATABASE_URL="postgresql://user:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require"

# 2. Application Base URL - REQUIRED
# Local development: http://localhost:5173
# Production: https://frostmail.netlify.app
ORIGIN="http://localhost:5173"

# 3. Better Auth - REQUIRED
# High-entropy secret for cookie/session encryption
# Generate via: openssl rand -base64 32
BETTER_AUTH_SECRET="your_better_auth_secret_here"

# 4. GitHub OAuth (Social Login) - REQUIRED for GitHub Sign-In
# https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 5. Resend (Email Testing) - OPTIONAL
# Used for dispatching live test emails from the editor without entering a key in the UI
# https://resend.com/api-keys
RESEND_API_KEY=""

# 6. Polar.sh (Payments & Pro Upgrades) - OPTIONAL (Required for Pro checkout)
# https://polar.sh/settings
POLAR_API_KEY=""
POLAR_PRO_PRODUCT_ID=""
POLAR_WEBHOOK_SECRET=""

# 7. Cloudflare R2 / S3 (Image Asset Hosting) - OPTIONAL (Falls back to base64)
# https://dash.cloudflare.com/ -> R2 Object Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="frostmail-assets"
R2_PUBLIC_DOMAIN="https://assets.yourdomain.com"

